
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "doribabs",

  "keep_vars": true,

  "main": ".open-next/worker.js",

  "compatibility_date": "2026-11-19",

  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "workers_dev": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "doribabs"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  "observability": {
    "enabled": true
  }
}
